# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  KOHLER CONCORD — Environment Configuration                             ║
# ║  Copy this file to .env and fill in your values.                         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# LLM Provider: "openai" or any OpenAI-compatible API
LLM_PROVIDER=openai

# API Key for your LLM provider (NEVER commit your actual key)
LLM_API_KEY=your-api-key-here

# Primary model (used for complex reasoning, verification, conflict detection)
LLM_MODEL=gpt-4o-mini

# Smaller/cheaper model (used for simple queries, routing, classification)
LLM_MODEL_SMALL=gpt-4o-mini

# Optional: Custom base URL for Azure OpenAI, local models, etc.
# LLM_BASE_URL=https://your-endpoint.openai.azure.com/v1

# Embedding model (sentence-transformers model name for local embeddings)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
CHROMA_DIR=./chroma_db
DATA_DIR=./data/knowledge_base
OUTPUT_DIR=./output

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Shared password for internal roles (Employee, HR Manager, Finance Analyst, Legal Counsel)
# Customer role does not require a password.
APP_PASSWORD=kohler2024
